<?xml version="1.0" encoding="UTF-8"?>
<WorkBook xmlVersion="20211223" releaseVersion="10.0.0">
<Report class="com.fr.report.worksheet.WorkSheet" name="bad_widget_mismatch">
<CellElementList>
<C c="0" r="0" s="0"><O t="DSColumn"><Attributes dsName="ds_main" columnName="acc"/><Complex/><Parameters/></O><PrivilegeControl/><Expand/></C>
</CellElementList>
</Report>
<TableDataMap>
<TableData name="ds_main" class="com.fr.data.impl.DBTableData"><Parameters/><Query><![CDATA[SELECT t.account AS acc, round(sum(COALESCE(NULLIF(t.data,'')::numeric,0)),2) AS amt
FROM demo_dws.demo_rates_hfm_sum_actual t
WHERE t.view='YTD'
AND t.entity IN (
    SELECT legal_code FROM demo_ads.fin_demo_auth_base_info f WHERE ('${para_plant}'='' OR f.plant_code='${para_plant}')
    UNION ALL SELECT plant_code FROM demo_ads.fin_demo_auth_base_info f WHERE ('${para_plant}'='' OR f.plant_code='${para_plant}'))
AND ((EXISTS(SELECT 1 FROM demo_ads.fin_demo_config_user_role WHERE role_id IN ('0','1') AND user_gid='${fine_username}'))
     OR t.entity IN (SELECT plant_code FROM demo_ads.fin_demo_auth_base_user_map WHERE user_gid='${fine_username}'))]]></Query></TableData>
</TableDataMap>
<ReportParameterAttr>
<Attributes showWindow="true"/><PWTitle><![CDATA[参数]]></PWTitle>
<Parameters><Parameter><Attributes name="para_plant"/><O><![CDATA[]]></O></Parameter></Parameters>
<ParameterUI class="com.fr.form.main.parameter.FormParameterUI">
<Parameters><Parameter><Attributes name="para_plant"/><O><![CDATA[]]></O></Parameter></Parameters>
<Layout class="com.fr.form.ui.container.WParameterLayout">
<WidgetName name="para"/>
<Widget class="com.fr.form.ui.container.WAbsoluteLayout$BoundsWidget">
<InnerWidget class="com.fr.form.ui.ComboBox"><WidgetName name="widget_foo"/></InnerWidget>
<BoundsAttr x="8" y="12" width="100" height="26"/>
</Widget>
</Layout>
</ParameterUI>
</ReportParameterAttr>
</WorkBook>
