<TableDataMap><TableData name="dict_area" class="com.fr.data.impl.DBTableData"><Parameters></Parameters><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[demo_connection]]></DatabaseName></Connection><Query><![CDATA[SELECT DISTINCT t.plant_code AS plant_code
FROM demo_ads.fin_demo_auth_base_info t
WHERE ((EXISTS(SELECT 1 FROM demo_ads.fin_demo_config_user_role WHERE role_id IN ('0','1') AND user_gid='${fine_username}')) OR EXISTS(SELECT 1 FROM demo_ads.fin_demo_auth_base_user_map m WHERE m.user_gid='${fine_username}' AND m.plant_code=t.plant_code))]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData></TableDataMap>
