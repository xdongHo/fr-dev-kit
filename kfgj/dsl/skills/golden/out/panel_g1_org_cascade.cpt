<TableDataMap><TableData name="dict_legal" class="com.fr.data.impl.DBTableData"><Parameters/><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[demo_connection]]></DatabaseName></Connection><Query><![CDATA[SELECT DISTINCT legal_code AS v, legal_code AS t FROM demo_ads.fin_demo_auth_base_info f WHERE legal_code IS NOT NULL AND legal_code <> '' AND ((EXISTS(SELECT 1 FROM demo_ads.fin_demo_config_user_role WHERE role_id IN ('0','1') AND user_gid='${fine_username}')) OR EXISTS(SELECT 1 FROM demo_ads.fin_demo_auth_base_user_map m WHERE m.user_gid='${fine_username}' AND m.plant_code=f.plant_code)) ORDER BY 1]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="dict_bu" class="com.fr.data.impl.DBTableData"><Parameters/><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[demo_connection]]></DatabaseName></Connection><Query><![CDATA[SELECT DISTINCT bu AS v, bu AS t FROM demo_ads.fin_demo_auth_base_info f WHERE bu IS NOT NULL AND bu <> '' AND ('${para_legal}'='' OR f.legal_code='${para_legal}') AND ((EXISTS(SELECT 1 FROM demo_ads.fin_demo_config_user_role WHERE role_id IN ('0','1') AND user_gid='${fine_username}')) OR EXISTS(SELECT 1 FROM demo_ads.fin_demo_auth_base_user_map m WHERE m.user_gid='${fine_username}' AND m.plant_code=f.plant_code)) ORDER BY 1]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="dict_region" class="com.fr.data.impl.DBTableData"><Parameters/><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[demo_connection]]></DatabaseName></Connection><Query><![CDATA[SELECT DISTINCT region AS v, region AS t FROM demo_ads.fin_demo_auth_base_info f WHERE region IS NOT NULL AND region <> '' AND ('${para_legal}'='' OR f.legal_code='${para_legal}') AND ('${para_bu}'='' OR f.bu='${para_bu}') AND ((EXISTS(SELECT 1 FROM demo_ads.fin_demo_config_user_role WHERE role_id IN ('0','1') AND user_gid='${fine_username}')) OR EXISTS(SELECT 1 FROM demo_ads.fin_demo_auth_base_user_map m WHERE m.user_gid='${fine_username}' AND m.plant_code=f.plant_code)) ORDER BY 1]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData><TableData name="dict_plant" class="com.fr.data.impl.DBTableData"><Parameters/><Attributes maxMemRowCount="-1"/><Connection class="com.fr.data.impl.NameDatabaseConnection"><DatabaseName><![CDATA[demo_connection]]></DatabaseName></Connection><Query><![CDATA[SELECT DISTINCT plant_code AS v, plant_code AS t FROM demo_ads.fin_demo_auth_base_info f WHERE plant_code IS NOT NULL AND plant_code <> '' AND (('${para_legal}'<>'' AND f.legal_code='${para_legal}') OR ('${para_bu}'<>'' AND f.bu='${para_bu}' AND ('${para_region}'='' OR f.region='${para_region}'))) AND ((EXISTS(SELECT 1 FROM demo_ads.fin_demo_config_user_role WHERE role_id IN ('0','1') AND user_gid='${fine_username}')) OR EXISTS(SELECT 1 FROM demo_ads.fin_demo_auth_base_user_map m WHERE m.user_gid='${fine_username}' AND m.plant_code=f.plant_code)) ORDER BY 1]]></Query><PageQuery><![CDATA[]]></PageQuery></TableData></TableDataMap>
