<Listener event="afterinit" name="init1">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
<Content>
<![CDATA[var __w = this;
setTimeout(function() {
var f = __w.options.form;
['para_legal','para_bu','para_region','para_plant'].forEach(function(n){
var w = f.getWidgetByName(n);
try { if (w.getValue() != null && w.getValue() != "") w.setEnable(false); } catch(e) {}
});
try { f.getWidgetByName("para_entity").setEnable(false); } catch(e) {}
}, 500);]]></Content>
</JavaScript>
</Listener>
