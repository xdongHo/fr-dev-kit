<WebWriteContent>
<Listener event="afterload">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
<Content>
<![CDATA[var arr1 = $('td[col=0]A');
var len1 = arr1.length;
var k;
for(k=4;k<len1;k++){//从第四行数据行开始合并
var arr = $('td','tr[tridx='+k+']A');
var len = arr.length;
arr.each(function(i, v) {
     var val = v.innerText;
	var total = 1;
	for (let j = i+1; j < len; j++) {
		if (val != arr[j]A.innerText) {
			
			break;
		}
		total += 1;
		arr[j]A.remove()
	}
	v.setAttribute("colspan", total);
})
}]]></Content>
</JavaScript>
</Listener>
