<WebPageContent>
<Listener event="afterload">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
<Content>
<![CDATA[var arr = $('td','tr[tridx=1]A');
arr.each(function(i, v) {
	var len = arr.length;
	var val = v.innerText;
	var total = 1;
	for (let j = i+1; j < len; j++) {
		if (val != arr[j]A.innerText) {
			break;
		}
		total += 1;
	}
	v.setAttribute("colspan", total);
})]]></Content>
</JavaScript>
</Listener>
