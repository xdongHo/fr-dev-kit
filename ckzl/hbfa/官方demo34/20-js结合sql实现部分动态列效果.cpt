<InnerWidget class="com.fr.form.ui.FreeButton">
<Listener event="click" name="点击1">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
<Content>
<![CDATA[var area = this.options.form.getWidgetByName('地区').getValue();
var product = this.options.form.getWidgetByName('产品').getValue();
var temp = this.options.form.getWidgetByName('temp');
if(product.length!=0){
	temp.setValue('产品');
	}
else{
	temp.setValue('地区');
	}

	_g().parameterCommit();]]></Content>
</JavaScript>
</Listener>
