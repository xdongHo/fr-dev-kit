<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=IF(LEN($aaa) = 0, &A8, if(inarray(&A8, split($aaa, ",")) > 0, joinarray(GREPARRAY(split($aaa, ","), item != &A8), ","), $aaa + "," + &A8))]]></Attributes>
</O>
