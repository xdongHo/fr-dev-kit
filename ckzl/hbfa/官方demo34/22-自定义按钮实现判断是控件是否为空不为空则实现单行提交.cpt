<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters>
<Parameter>
<Attributes name="co"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=col() - 1]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="ro"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=row() - 1]]></Attributes>
</O>
</Parameter>
</Parameters>
<Content>
<![CDATA[//alert(co);
//alert(ro);
var a =  _g().getWidgetByCell(FR.columnRow2CellStr({col:co-2, row:ro})).getValue();
alert(a);
if(a.length === 0){
	alert("控件为空，请输入值");}
	else{
_g().getWidgetByCell(FR.columnRow2CellStr({col:co-1, row:ro})).fireEvent("click");
	}]]></Content>
</JavaScript>
