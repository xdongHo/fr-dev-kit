<HtmlLabel customText="function() {
 var per;
 if (this.targetValue == 0.00000000001) {
  per = &apos;100%&apos;;
 } else {
  per = FR.contentFormat(this.value / this.targetValue, &apos;#0%&apos;)
 }
 return &quot;&lt;span style=&apos;font-family:dingtalk !important;&apos;&gt;&quot; + per + &quot;&lt;br&gt;&quot; + FR.contentFormat(this.value, &quot;#,##0&quot;) + &quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&apos;font-style:italic;font-size:14px;color:#666666&apos;&gt;Goal &quot; + FR.contentFormat(this.targetValue, &quot;#,##0&quot;) + &quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&apos;font-size:12px;color:#666666&apos;&gt;&amp;nbsp;&lt;/span&gt;&quot;;
}" useHtml="true" isCustomWidth="false" isCustomHeight="false" width="50" height="50"/>
