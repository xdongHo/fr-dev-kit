{
  "name": "fr-dev-kit-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZCode MCP App plugin for the FineReport report dev kit (source package; runtime is dist/)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:server": "node esbuild.mjs",
    "build:ui": "cross-env INPUT=console.html vite build",
    "build": "npm run typecheck && npm run build:server && npm run build:ui",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
